# rHarness — environment configuration (copy to .env and fill in as needed).
# All variables are optional; rHarness runs fully local/offline in demo mode
# when no API key is set. Never commit a real .env file.

# --- LLM provider (OpenAI-compatible) -----------------------------------------
# Leave RHA_API_KEY empty to use the built-in DemoProvider (offline, deterministic).
RHA_API_KEY=
# Base URL of an OpenAI-compatible endpoint.
RHA_BASE_URL=https://api.openai.com/v1
# Model identifier passed to the provider.
RHA_MODEL=gpt-4o-mini

# --- Local web server ---------------------------------------------------------
RHA_PORT=4321
RHA_HOST=127.0.0.1

# --- Local model tuning (GLM-5.3 / EXL3 / GGUF / NVFP4) ----------------------
# Point RHA_BASE_URL at a local OpenAI-compatible endpoint to use a local model, e.g.
#   RHA_BASE_URL=http://127.0.0.1:18080/v1
#   RHA_MODEL=glm-5.3-flash-exl3-k2-single-spark
# Local endpoints (127.0.0.1 / localhost) need no RHA_API_KEY.
#
# Reasoning / thinking knobs for GLM-5.3 (sent to the provider):
#   RHA_ENABLE_THINKING=true|false   → chat_template_kwargs.enable_thinking
#   RHA_REASONING_EFFORT=low|high    → reasoning_effort
#   RHA_MAX_TOKENS=32768             → keep ≥ 32768 while thinking is on
RHA_MAX_TOKENS=32768
RHA_ENABLE_THINKING=
RHA_REASONING_EFFORT=

# --- Plugins ------------------------------------------------------------------
# Where the memory plugin stores its persistent notes (defaults to ~/.rharness/memory.json).
RHA_MEMORY_FILE=
