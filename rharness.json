{
  "name": "rHarness",
  "version": "1.0.0",
  "tagline": "Finish First.",
  "description": "A finish-first autonomous agent loop and an open, plugin-based agent harness. Define intent, run the loop, ship the result.",
  "core": "./dist/core.js",
  "loop": "finish-first",
  "engine": "harness-core",
